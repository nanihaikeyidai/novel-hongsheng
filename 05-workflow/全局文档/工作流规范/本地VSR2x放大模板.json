{
  "prompt": {
    "1": {
      "class_type": "LoadVideo",
      "inputs": {
        "file": "__VIDEO__",
        "upload": "image"
      }
    },
    "2": {
      "class_type": "GetVideoComponents",
      "inputs": {
        "video": ["1", 0]
      }
    },
    "3": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "relayvsr_x2_lightx2v_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "relayvsr_flash_vae_x2_fp32.safetensors"
      }
    },
    "5": {
      "class_type": "RelayVSRConditioning",
      "inputs": {
        "model": ["3", 0],
        "images": ["2", 0]
      }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["3", 0],
        "positive": ["5", 0],
        "negative": ["5", 0],
        "latent_image": ["5", 1],
        "seed": 0,
        "steps": 1,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "7": {
      "class_type": "VSRDecode",
      "inputs": {
        "vae": ["4", 0],
        "samples": ["6", 0],
        "images": ["2", 0],
        "detail": 0.5
      }
    },
    "8": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": ["7", 0],
        "fps": ["2", 2],
        "audio": ["2", 1],
        "bit_depth": "auto",
        "color_space": "sRGB",
        "codec": "none"
      }
    },
    "9": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["8", 0],
        "filename_prefix": "__PREFIX__",
        "format": "auto",
        "codec": "auto"
      }
    }
  }
}
